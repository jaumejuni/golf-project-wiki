# Copy this file to .env.deploy (gitignored) and fill in real values.
# .env.deploy is never committed - it holds live FTP credentials.

FTP_HOST=ftp.example.com
# Optional, defaults to 21
FTP_PORT=21
FTP_USER=changeme
FTP_PASS=changeme
# ftp or ftps. Plain ftp sends credentials unencrypted - use ftps if your host supports it.
FTP_PROTOCOL=ftp

# Absolute path on the FTP server to deploy the site into. Must not be empty or "/".
FTP_REMOTE_DIR=/path/to/site

# Arbitrary string used to confirm FTP_REMOTE_DIR is the right folder before
# scDeploy.sh deletes anything there. Pick any value, then run
# ./scDeploy.sh --init-marker once to write it to the server.
FTP_DEPLOY_MARKER=change-this-to-a-random-string
